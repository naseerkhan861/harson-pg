# Server
PORT=3000

# JWT secret for signing login tokens
JWT_SECRET=some_long_random_secret_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?appName=<app-name>

# Optional: override DNS resolvers (e.g. 8.8.8.8,1.1.1.1) if *.mongodb.net is
# DNS-poisoned on your network. Leave unset where DNS is clean (production).
MONGO_DNS_SERVERS=

# yibaiaigc integration
YIBAI_AIGC_HOST=https://yibaiaigc.com
YIBAI_USER_DATA_HOST=https://yibaiaigc.com

# true = 使用本地模拟结果
# false = 调用真实 yibaiaigc 接口
YIBAI_AIGC_MOCK=false

# External API request timeout in milliseconds
YIBAI_AIGC_TIMEOUT_MS=10000

# AES-256-GCM key used to encrypt cached yibaiaigc login tokens.
# Generate a 64-character hexadecimal key. Never commit the real key.
YIBAI_AIGC_TOKEN_ENCRYPTION_KEY=6d7d301a1a7d3b8b4ece3fa7d0ece80dd79203d987531999929fe8a1063d21c6

# 用于加密管理员在网页中提交的 YiBai 登录密码
# 必须是 64 个十六进制字符，即 32 字节
YIBAI_AIGC_CREDENTIAL_ENCRYPTION_KEY=8bd9afb50a09aafac3e027ff263fd9c4f6ec81ca1a5d041b145e0994ceba6c46


# Mock 模式下模拟返回的企业和点数信息
YIBAI_AIGC_MOCK_COMPANY_ID=10001
YIBAI_AIGC_MOCK_COMPANY_NAME="HARSON Mock Enterprise"
YIBAI_AIGC_MOCK_MPOINT=1000
YIBAI_AIGC_MOCK_COMPANY_MPOINT=5000

# ---------------------------------------------------------------------------
# Image-tab display-name gateway (ai.harson-base.com)
# Aliases: 悠船Midjourney V7->HarsonMD, 全能图片->Harson-ZP, 即梦->Harson-SD,
#          GPT-image-2->HarsonIM2, FLUX.1 Kontext->HarsonFK1, FLUX Krea->HarsonFK
# ---------------------------------------------------------------------------
# Public origin of the frame gateway. EMPTY = every module's iframe goes
# direct to YiBai (current default behavior; nothing below has any effect).
YIBAI_FRAME_PUBLIC_ORIGIN=

# Inject the image-tab display scripts through the gateway. The gateway
# proxies fine with this off (pilot mode); true renames the six labels
# inside the image tab iframe. Only image-generator uses the gateway.
YIBAI_IMAGE_ALIASES_ENABLED=false

# Shared secret for app <-> gateway internal calls (64 hex chars).
# Generate with: openssl rand -hex 32
HARSON_INTERNAL_API_SECRET=

# Lifetime of one-time frame launch tickets, in seconds.
YIBAI_FRAME_TICKET_TTL_SECONDS=60

# Port the gateway listens on inside its container.
GATEWAY_PORT=3001

# How the gateway reaches the main app (compose service name by default).
HARSON_APP_INTERNAL_ORIGIN=http://app:3000

# How the main app reaches the gateway for logout revocation.
YIBAI_GATEWAY_INTERNAL_ORIGIN=http://gateway:3001

# Local testing only: override the gateway's upstream (defaults to YIBAI_AIGC_HOST).
GATEWAY_UPSTREAM=

# Extra proxied path prefixes discovered during the gateway pilot
# (comma separated). /frame/app/* hosts YiBai's in-frame sub-tools
# (e.g. 爆款视频复刻 / app-viral-video-replicator) — without /frame the
# gateway returns 404 for them while direct YiBai works.
YIBAI_GATEWAY_EXTRA_PATHS=/assets,/api,/favicon.ico,/version.json,/frame

# ---- SSO 免登录跳转：HARSON -> HarsonFOOT（3D 足型测量平台）----
# HarsonFOOT 的公网地址（生产环境请改为正式域名，如 https://harson-base-health.com）
SSO_FOOT_BASE_URL=https://harson-base-health.com

# 与 HarsonFOOT 共享的 HMAC-SHA256 签名密钥。
# 必须与对端服务端配置完全一致，否则跳转会被判为 invalid 并回到登录页。
# 注意：该密钥属于敏感信息，不要提交到任何代码仓库。
SSO_FOOT_SHARED_SECRET=REPLACE_WITH_SHARED_SECRET_MATCHING_HARSON_PG

# SSO 票据有效期（秒），默认 60
SSO_FOOT_TTL_SECONDS=60
