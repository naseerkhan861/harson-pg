# Server
PORT=3000

# JWT secret for signing login tokens
JWT_SECRET=some_long_random_secret_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?appName=<app-name>

# yibaiaigc integration
YIBAI_AIGC_HOST=https://cl-base.yibaiaigc.com

# true = 使用本地模拟结果
# false = 调用真实 yibaiaigc 接口
YIBAI_AIGC_MOCK=false

# External API request timeout in milliseconds
YIBAI_AIGC_TIMEOUT_MS=10000

# AES-256-GCM key used to encrypt cached yibaiaigc login tokens.
# Generate a 64-character hexadecimal key. Never commit the real key.
YIBAI_AIGC_TOKEN_ENCRYPTION_KEY=

# 用于加密管理员在网页中提交的 YiBai 登录密码
# 必须是 64 个十六进制字符，即 32 字节
YIBAI_AIGC_CREDENTIAL_ENCRYPTION_KEY=


# Mock 模式下模拟返回的企业和点数信息
YIBAI_AIGC_MOCK_COMPANY_ID=10001
YIBAI_AIGC_MOCK_COMPANY_NAME="HARSON Mock Enterprise"
YIBAI_AIGC_MOCK_MPOINT=1000
YIBAI_AIGC_MOCK_COMPANY_MPOINT=5000